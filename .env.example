DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080
ONEBOT_ACCESS_TOKEN=replace-with-a-random-long-token

# All joined groups can chat. Owners retain global management permissions.
BOT_OWNERS=[]
# Optional local names for QQ IDs, e.g. {"123456789":"Alice"}.
USER_NAMES={}
MEMORY_PROFILE_MIN_MESSAGES=10
KNOWLEDGE_CLEANUP_ENABLED=true
KNOWLEDGE_CLEANUP_INTERVAL_HOURS=24

# Select one provider per process. Official endpoints are built in.
# Fill a model ID available to your account; no model is silently substituted.
LLM_PROVIDER=deepseek
# 是否开启深度思考；需所选型号支持，不显示思考内容
LLM_THINKING_ENABLED=false
# 模型诊断日志默认开启；记录动态上下文和工具内容，固定提示词仅保存引用
MODEL_TRACE_ENABLED=true
MODEL_TRACE_RETENTION_DAYS=7
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional. Without a key the model is told it cannot search.
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_SECONDS=15
SEARCH_MAX_CALLS=2

LLM_TIMEOUT_SECONDS=60
REQUEST_TIMEOUT_SECONDS=180
LLM_MAX_CONCURRENCY=2
LLM_MAX_OUTPUT_TOKENS=2048
QUEUE_TIMEOUT_SECONDS=3
MAX_PENDING_REQUESTS=32
USER_COOLDOWN_SECONDS=5
SESSION_TTL_SECONDS=1800
SESSION_MAX_TURNS=8
SESSION_MAX_CHARS=12000
INPUT_MAX_CHARS=4000
DEDUP_TTL_SECONDS=300
REPLY_CHUNK_CHARS=1500
REPLY_MAX_MESSAGES=3

# 模型自主分享普通私聊至共同群；false仅关闭主动发送
PROACTIVE_SHARE_ENABLED=true

# Images go directly to the active chat model using its existing API key.
# The configured model must support image input (e.g. deepseek-flash).
VISION_MAX_IMAGES=3

# Local reaction images, relative to the project root.
EMOTES_DIR=emotes
EMOTES_MAX_BYTES=5242880

# Let the model collect group memes and search for new ones when useful.
# Online image search requires SEARCH_API_KEY (Tavily).
EMOTES_AUTO_COLLECT=true
EMOTES_DAILY_IMPORT_LIMIT=20

# NapCat 启动文件路径；留空时首次启动询问并保存，建议使用正斜杠
NAPCAT_LAUNCHER=
# 本机 NapCat 监听端口，通常为 WebUI 端口
NAPCAT_PORT=6099

# 本机 dsh 任务：所有群共享并发上限，修改后重启机器人
TASK_MAX_CONCURRENCY=2
TASK_TIMEOUT_SECONDS=1800
TASK_MAX_STEPS=80
# 留空自动查找 Windows 当前用户全局 npm 安装；仅适配 0.1.0-rc.7
DSH_PACKAGE_DIR=
DSH_MODEL=deepseek-v4-flash
